# Machine config for the GAMER-dedicated Claude cloud environment (apt-installed
# g++ / OpenMPI / nvidia-cuda-toolkit on Ubuntu 24.04). No physical GPU on this VM;
# CUDA builds compile and link but can never run.
CUDA_PATH       /usr
MPI_PATH        /usr

CXX     g++
CXX_MPI mpicxx

CXXFLAG -g
CXXFLAG -O3
CXXFLAG -std=c++11
CXXFLAG -Wall
CXXFLAG -Wextra
CXXFLAG -Wno-unused-variable
CXXFLAG -Wno-unused-parameter
CXXFLAG -Wno-maybe-uninitialized
CXXFLAG -Wno-unused-but-set-variable
CXXFLAG -Wno-unused-function
CXXFLAG -Wno-unused-result
CXXFLAG -Wno-implicit-fallthrough
CXXFLAG -Wno-parentheses
CXXFLAG -Wno-unknown-pragmas

OPENMPFLAG -fopenmp

# Required to *link* --gpu=true builds: Ubuntu's nvidia-cuda-toolkit puts libcudart
# under the multiarch dir, not $(CUDA_PATH)/lib64 as GAMER's Makefile expects.
LIBFLAG -L/usr/lib/x86_64-linux-gnu

NVCCFLAG_COM -O3
NVCCFLAG_FLU -Xptxas -dlcm=ca -prec-div=false -ftz=true
NVCCFLAG_POT -Xptxas -dlcm=ca

# Hardcoded, not -1: auto-detect shells out to nvidia-smi, which doesn't exist here
# (no GPU driver, since there's no device). 750 (Turing) just needs to be valid for
# nvcc to compile against -- change it if you need a specific arch's ptx.
GPU_COMPUTE_CAPABILITY 750